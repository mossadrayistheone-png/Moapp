# Copy this file to .env and fill in the values.
# Never commit the real .env file to version control.

NODE_ENV=production

# JSON Web Token secret — generate with:
#   node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=

# PostgreSQL connection string
DATABASE_URL=

# OpenAI API key (Whisper + GPT-4o-mini)
OPENAI_API_KEY=

# ElevenLabs API key + voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
