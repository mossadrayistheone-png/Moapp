modules = ["nodejs-24", "python-base-3.13"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "apps/web: Web Frontend"

[[workflows.workflow]]
name = "apps/web: Web Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && PORT=3000 pnpm run dev"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18361
externalPort = 3000

[[ports]]
localPort = 25629
externalPort = 80

[userenv]

[userenv.shared]
ELEVENLABS_VOICE_ID = "KB1SgdCQOsA9N9XwXxBB"
REVENUECAT_PROJECT_ID = "proj7d405e07"
